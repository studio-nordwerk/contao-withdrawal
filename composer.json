{
  "name": "nordwerk/contao-withdrawal-bundle",
  "description": "Electronic withdrawal button (Widerrufsbutton) for Contao under § 356a BGB",
  "license": "MIT",
  "type": "contao-bundle",
  "keywords": [
    "contao",
    "withdrawal",
    "widerruf",
    "widerrufsbutton",
    "356a-bgb"
  ],
  "require": {
    "php": "^8.3",
    "contao/core-bundle": "^5.7",
    "egulias/email-validator": "^4.0",
    "tijsverkoyen/css-to-inline-styles": "^2.4"
  },
  "autoload": {
    "psr-4": {
      "Nordwerk\\WithdrawalBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Nordwerk\\WithdrawalBundle\\Tests\\": "tests/"
    }
  },
  "extra": {
    "contao-manager-plugin": "Nordwerk\\WithdrawalBundle\\ContaoManager\\Plugin"
  }
}
