<!doctype html>
<html lang="{{ locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <meta name="supported-color-schemes" content="light dark">
    <title>{{ subject|e('html') }}</title>
    <style>
        :root { color-scheme: light dark; }
        .nw-mail-body { margin: 0; padding: 24px 12px; background: #f5f3ef; color: #292723; font: 16px/1.5 Arial, Helvetica, sans-serif; }
        .nw-mail-card { width: 100%; max-width: 600px; margin: 0 auto; background: #fffaf7; border: 1px solid #cfc4cb; }
        .nw-mail-pad { padding: 24px 28px; }
        .nw-mail-brand { color: {{ accent }}; font-size: 20px; font-weight: bold; border-bottom: 3px solid {{ accent }}; }
        .nw-mail-content { margin: 0 0 16px; white-space: pre-wrap; overflow-wrap: anywhere; }
        .nw-mail-heading { margin: 24px 0 6px; color: {{ accent }}; font-size: 16px; font-weight: bold; }
        .nw-mail-preheader { display: none; max-height: 0; overflow: hidden; opacity: 0; }
        .nw-mail-muted { color: #6b6470; font-size: 14px; }
        .nw-mail-action { margin: 4px 0 24px; }
        .nw-mail-button { display: inline-block; padding: 12px 22px; border-radius: 999px; background: {{ accent }}; color: {{ accent_text }}; font-weight: bold; text-decoration: none; }
        .nw-mail-box { width: 100%; margin: 0 0 24px; border-collapse: separate; background: #f3ede9; border-radius: 10px; }
        .nw-mail-box td { padding: 16px 18px; }
        .nw-mail-box-title { margin: 0 0 6px; font-size: 16px; font-weight: bold; }
        .nw-mail-box-image { padding-top: 0 !important; text-align: center; }
        .nw-mail-items { width: 100%; border-collapse: collapse; margin: 0; }
        .nw-mail-items td { padding: 12px 0; border-bottom: 1px solid #e3dade; vertical-align: top; }
        .nw-mail-thumb { width: 64px; padding-right: 14px !important; }
        .nw-mail-thumb img { display: block; width: 64px; height: 64px; border-radius: 8px; }
        .nw-mail-name { font-weight: bold; color: #292723; text-decoration: none; }
        .nw-mail-num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; padding-left: 12px !important; }
        .nw-mail-totals { width: 100%; border-collapse: collapse; margin: 10px 0 4px; }
        .nw-mail-totals td { padding: 3px 0; font-variant-numeric: tabular-nums; }
        .nw-mail-totals td + td { text-align: right; white-space: nowrap; }
        .nw-mail-strong td { padding-top: 8px; font-size: 18px; font-weight: bold; }
        .nw-mail-note { margin: 0 0 24px; }
        .nw-mail-facts { width: 100%; border-collapse: collapse; margin: 8px 0 20px; border-top: 1px solid #e3dade; }
        .nw-mail-facts td { padding: 8px 0; border-bottom: 1px solid #e3dade; vertical-align: top; white-space: pre-wrap; }
        .nw-mail-facts td:first-child { width: 38%; padding-right: 12px; color: #6b6470; white-space: normal; }
        .nw-mail-legal { border-top: 1px solid #e3dade; color: #4f4954; font-size: 13px; line-height: 1.5; }
        .nw-mail-legal-title { margin: 0 0 4px; font-size: 15px; font-weight: bold; }
        .nw-mail-legal-heading { margin: 18px 0 4px; font-size: 13px; font-weight: bold; }
        .nw-mail-footer { border-top: 1px solid #e3dade; color: #6b6470; font-size: 12px; line-height: 1.5; text-align: center; white-space: pre-wrap; }
        @media (max-width: 480px) {
            .nw-mail-pad { padding: 18px 14px !important; }
            .nw-mail-thumb, .nw-mail-thumb img { width: 48px !important; height: 48px !important; }
            .nw-mail-facts td:first-child { width: 40% !important; }
        }
        @media (prefers-color-scheme: dark) {
            .nw-mail-body { background: #211d22 !important; color: #f6f0f3 !important; }
            .nw-mail-card { background: #302936 !important; border-color: #716473 !important; }
            .nw-mail-brand, .nw-mail-heading, .nw-mail-name { color: #f6edf2 !important; }
            .nw-mail-box { background: #3d3443 !important; }
            .nw-mail-muted, .nw-mail-facts td:first-child, .nw-mail-footer, .nw-mail-legal { color: #cfc4cb !important; }
            .nw-mail-items td, .nw-mail-facts, .nw-mail-facts td, .nw-mail-legal, .nw-mail-footer { border-color: #716473 !important; }
        }
    </style>
</head>
<body class="nw-mail-body">
    <div class="nw-mail-preheader" aria-hidden="true">{{ preheader|e('html') }}</div>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" class="nw-mail-card" width="600">
        <tr><td class="nw-mail-pad nw-mail-brand">{% if logo %}<img src="cid:nw-logo" alt="{{ brand|e('html_attr') }}" style="max-width:180px;max-height:64px;width:auto;height:auto;vertical-align:middle">{% else %}{{ brand|e('html') }}{% endif %}</td></tr>
        <tr><td class="nw-mail-pad">
            {% if introduction %}<p class="nw-mail-content">{{ introduction|e('html') }}</p>{% endif %}
            {% if action %}<p class="nw-mail-action"><a class="nw-mail-button" href="{{ action.url|e('html_attr') }}">{{ action.label|e('html') }}</a></p>{% endif %}
            {% for box in boxes %}
                <table role="presentation" class="nw-mail-box" cellpadding="0" cellspacing="0" border="0" width="100%">
                    <tr><td><p class="nw-mail-box-title">{{ box.title|e('html') }}</p><p class="nw-mail-content" style="margin:0">{{ box.text|e('html') }}</p></td></tr>
                    {% if box.image is defined %}<tr><td class="nw-mail-box-image">{% if box.image.caption|default('') %}<p class="nw-mail-muted" style="margin:0 0 8px">{{ box.image.caption|e('html') }}</p>{% endif %}<img src="{{ box.image.src|e('html_attr') }}" width="{{ box.image.width }}" height="{{ box.image.width }}" alt="{{ box.image.alt|e('html_attr') }}"></td></tr>{% endif %}
                </table>
            {% endfor %}
            {% if items %}
                <table role="presentation" class="nw-mail-items" cellpadding="0" cellspacing="0" border="0" width="100%">
                    {% for item in items %}
                        <tr>
                            {% if thumbnails %}<td class="nw-mail-thumb" width="64">{% if item.image|default('') %}<img src="{{ item.image|e('html_attr') }}" width="64" height="64" alt="">{% endif %}</td>{% endif %}
                            <td>
                                {% if item.url|default('') %}<a class="nw-mail-name" href="{{ item.url|e('html_attr') }}">{{ item.name|e('html') }}</a>{% else %}<span class="nw-mail-name">{{ item.name|e('html') }}</span>{% endif %}
                                {% if item.meta|default('') %}<br><span class="nw-mail-muted">{{ item.meta|e('html') }}</span>{% endif %}
                                <br><span class="nw-mail-muted">{{ item.quantity|e('html') }} × {{ item.unit|e('html') }}</span>
                            </td>
                            <td class="nw-mail-num">{{ item.amount|e('html') }}</td>
                        </tr>
                    {% endfor %}
                </table>
            {% endif %}
            {% if totals %}<table role="presentation" class="nw-mail-totals" cellpadding="0" cellspacing="0" border="0" width="100%">{% for total in totals %}<tr{% if total.strong|default(false) %} class="nw-mail-strong"{% endif %}><td>{{ total.label|e('html') }}</td><td>{{ total.amount|e('html') }}</td></tr>{% endfor %}</table>{% endif %}
            {% if totals_note %}<p class="nw-mail-muted nw-mail-note">{{ totals_note|e('html') }}</p>{% elseif totals %}<p class="nw-mail-note"></p>{% endif %}
            {% if facts %}<table role="presentation" class="nw-mail-facts" cellpadding="0" cellspacing="0" border="0" width="100%">{% for fact in facts %}<tr><td>{{ fact.label|e('html') }}</td><td>{{ fact.value|e('html') }}</td></tr>{% endfor %}</table>{% endif %}
            {% for section in sections %}<h2 class="nw-mail-heading">{{ section.title|e('html') }}</h2><p class="nw-mail-content">{{ section.text|e('html') }}</p>{% endfor %}
            {% if closing %}<p class="nw-mail-content">{{ closing|e('html') }}</p>{% endif %}
            {% if greeting or signature %}<p class="nw-mail-content">{{ greeting|e('html') }}{% if signature %}<br>{{ signature|e('html') }}{% endif %}</p>{% endif %}
        </td></tr>
        {% if legal %}
            <tr><td class="nw-mail-pad nw-mail-legal">
                <p class="nw-mail-legal-title">{{ locale == 'en' ? 'Your contract documents' : 'Ihre Vertragsunterlagen' }}</p>
                {% for section in legal %}<h3 class="nw-mail-legal-heading">{{ section.title|e('html') }}</h3><p class="nw-mail-content" style="margin:0">{{ section.text|e('html') }}</p>{% endfor %}
            </td></tr>
        {% endif %}
        {% if footer %}<tr><td class="nw-mail-pad nw-mail-footer">{{ footer|e('html') }}</td></tr>{% endif %}
    </table>
</body>
</html>
