<?php $escape = static fn ($value): string => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8'); ?>
<h2 class="sub_headline">Widerrufsfunktion einrichten</h2>
<?php if ($this->error): ?><div class="tl_message"><p class="tl_error" role="alert"><?= $escape($this->error) ?></p></div><?php endif; ?>
<?php if ($this->saved): ?><div class="tl_message"><p class="tl_confirm">Einstellungen gespeichert.</p></div><?php endif; ?>
<form class="tl_form tl_edit_form" method="post" action="contao?do=withdrawal_settings">
    <div class="tl_formbody_edit"><fieldset class="tl_tbox">
        <legend>Versand und Link</legend>
        <input type="hidden" name="REQUEST_TOKEN" value="<?= $escape($this->requestToken) ?>">
        <div class="widget"><h3><label for="ctrl_merchantEmail">Händleradresse für Widerrufsmails</label></h3>
            <input class="tl_text" id="ctrl_merchantEmail" type="email" name="merchantEmail" required value="<?= $escape($this->values['merchantEmail']) ?>"></div>
        <div class="widget"><h3><label for="ctrl_path">Öffentlicher Pfad der Widerrufsfunktion</label></h3>
            <input class="tl_text" id="ctrl_path" type="text" name="path" required value="<?= $escape($this->values['path']) ?>">
            <p class="tl_help tl_tip">Zum Beispiel /withdrawal oder /service/widerruf. Die Seite muss veröffentlicht und ungeschützt sein.</p></div>
    </fieldset></div>
    <div class="tl_formbody_submit"><div class="tl_submit_container"><button class="tl_submit" type="submit">Speichern</button></div></div>
</form>
<p class="tl_info">WITHDRAWAL_MERCHANT_EMAIL und WITHDRAWAL_PATH überschreiben diese Werte optional.</p>
